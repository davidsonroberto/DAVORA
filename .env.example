# Configure somente no servidor da hospedagem. Nunca use credenciais neste arquivo.
DAVORA_CHECKOUT_ENABLED=false
DAVORA_SUPPLIER_APPROVED=false
DAVORA_MERCHANT_REVIEWED=false
DAVORA_STORE_ORIGIN=
DAVORA_CHECKOUT_SECRET=
# Registro durável privado. Nunca compartilhar as chaves nem mudar a chave
# de criptografia com pedidos existentes sem uma migração dos dados.
DAVORA_ORDERS_ENABLED=false
DAVORA_ORDER_NAMESPACE=preview
DAVORA_ORDER_ENCRYPTION_KEY=
BLOB_READ_WRITE_TOKEN=
# Alternativa OIDC: BLOB_STORE_ID + VERCEL_OIDC_TOKEN gerenciado pela Vercel.
BLOB_STORE_ID=
STRIPE_WEBHOOK_SECRET=
# Só true após entrega e processamento de um evento real de teste.
DAVORA_WEBHOOK_VERIFIED=false
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# A integração nativa Stripe da Vercel fornece esta alternativa automaticamente.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Habilitar apenas depois de confirmar a disponibilidade do Pix nesta conta Stripe.
STRIPE_PIX_ENABLED=false
# Regras por pedido completo, confirmadas com o fornecedor, em centavos.
# Sem exemplos de preços: não publicar frete estimado como valor contratado.
DAVORA_SHIPPING_RULES=[]
